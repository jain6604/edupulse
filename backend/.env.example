# Local development or Render environment variables. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=generate-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GEMINI_API_KEY=your-gemini-key
# Optional: Gmail SMTP welcome email (use a Google App Password, not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sending-email@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-sending-email@gmail.com
